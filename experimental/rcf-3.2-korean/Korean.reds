    this.Text("DVRCF.sortMixZA",    "혼합 - Z→A");
    this.Text("DVRCF.sortSplitAZ",  "프레임워크별 - A→Z");
    this.Text("DVRCF.sortSplitZA",  "프레임워크별 - Z→A");
    this.Text("DVRCF.sortMost",     "옵션 많은 순");
    this.Text("DVRCF.sortFewest",   "옵션 적은 순");
    this.Text("DVRCF.pickerTitle",  "설정할 모드 선택");
    this.Text("DVRCF.optionsTitle", "옵션");
    this.Text("DVRCF.filterHint",    "모드 필터...");
    this.Text("DVRCF.filterNoMatch", "일치하는 모드 없음");

    this.Text("DVRCF.on",  "켜짐");
    this.Text("DVRCF.off", "꺼짐");
    this.Text("DVRCF.pressKey", "키를 누르세요 (Esc: 해제)");

    this.Text("DVRCF.resetTitle",  "초기화 또는 되돌리기");
    this.Text("DVRCF.revert",      "변경 사항 되돌리기 (현재 세션)");
    this.Text("DVRCF.resetSubtab", "현재 하위 탭 초기화");
    this.Text("DVRCF.resetTab",    "현재 탭 초기화");
    this.Text("DVRCF.resetMod",    "모드 전체 초기화");
    this.Text("DVRCF.cancel",      "취소");
    this.Text("DVRCF.numOk",       "확인");
    this.Text("DVRCF.numClear",    "비우기");
