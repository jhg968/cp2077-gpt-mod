    this.Text("DVRCF.numRange",    "{0} ~ {1}");

    this.Text("DVRCF.opt.display",      "표시");
    this.Text("DVRCF.opt.scale",        "배율");
    this.Text("DVRCF.opt.overallScale", "전체 배율");
    this.Text("DVRCF.opt.textSize",     "글자 크기");
    this.Text("DVRCF.opt.controls",     "조작");
    this.Text("DVRCF.opt.openKey",      "설정 창 열기 단축키");
    this.Text("DVRCF.opt.openKey.tip",  "설정 허브를 여는 키입니다. 즉시 적용됩니다. RedRCFInput 플러그인이 없으면 기본 F8 키가 유지됩니다.");
    this.Text("DVRCF.opt.openMod",      "열기 단축키 보조 키");
    this.Text("DVRCF.opt.openMod.tip",  "열기 단축키를 누를 때 함께 눌러야 하는 선택형 보조 키입니다(키보드 또는 게임패드). 없음으로 설정하면 단축키만 사용합니다. 사용 가능한 키가 부족할 때 조합 입력으로 활용할 수 있습니다.");
    this.Text("DVRCF.noInputPlugin",    "RedRCFInput 플러그인 누락");
    this.Text("DVRCF.menuEntry",        "모드 설정");
    this.Text("DVRCF.keyNone",          "없음");
    this.Text("DVRCF.opt.hideMsEntries",     "Mod Settings 메뉴 항목 숨기기");
    this.Text("DVRCF.opt.hideMsEntries.tip", "메인 메뉴, 일시정지 메뉴, 사망 메뉴에서 Mod Settings 항목을 제거합니다. 해당 모드의 설정은 이 허브에서 계속 변경할 수 있습니다. 각 메뉴를 다음에 열 때 적용됩니다.");
    this.Text("DVRCF.opt.hideMsMods",       "Mod Settings 모드 숨기기");
    this.Text("DVRCF.opt.hideMsMods.tip",   "Mod Settings를 사용하는 모드를 이 허브에서 완전히 숨깁니다. 모드 목록, 검색, 위키에 표시되지 않으며 해당 모드는 Mod Settings 자체 메뉴에서 설정해야 합니다. 기본값은 꺼짐입니다.");
    this.Text("DVRCF.opt.menuEntryOn",       "모드 설정 항목 (마스터 스위치)");
    this.Text("DVRCF.opt.menuEntryOn.tip",   "모든 메뉴의 모드 설정 항목을 제어하는 마스터 스위치입니다. 끄면 아래 세 설정과 관계없이 모든 메뉴에서 제거되지만 열기 단축키는 계속 작동합니다. 각 메뉴를 다음에 열 때 적용됩니다.");
    this.Text("DVRCF.opt.menuEntryMain",     "메인 메뉴에 표시");
    this.Text("DVRCF.opt.menuEntryPause",    "일시정지 메뉴에 표시");
    this.Text("DVRCF.opt.menuEntryDeath",    "사망 메뉴에 표시");
    this.Text("DVRCF.opt.menuUpMain",        "메인 메뉴 위치");
    this.Text("DVRCF.opt.menuUpPause",       "일시정지 메뉴 위치");
    this.Text("DVRCF.opt.menuUpDeath",       "사망 메뉴 위치");
    this.Text("DVRCF.opt.menuUp.tip",        "각 메뉴 목록에서 모드 설정 항목을 단계당 한 칸씩 위로 이동합니다. 0은 기본 위치, 1은 한 칸 위이며 이후 같은 방식으로 올라갑니다. 목록 맨 위를 넘으면 첫 번째에 배치됩니다. 메뉴마다 항목 구성이 다르므로 각각 설정합니다.");
    this.Text("DVRCF.wikiFramework",    "Redscript Config Framework");
    this.Text("DVRCF.wikiLegend",       "목차");
    this.Text("DVRCF.logsTitle",        "RedLogger");
    this.Text("DVRCF.logs",             "로그");
    this.Text("DVRCF.logPrev",          "이전");
    this.Text("DVRCF.logNext",          "다음");
    this.Text("DVRCF.logSearchPrompt",  "검색:");
    this.Text("DVRCF.logMatches",       "건 일치");
    this.Text("DVRCF.logsDesc",         "게임 내 로그 뷰어입니다. 모드별 최신 로그를 한 섹션씩 표시합니다. 모드는 RedLogger.Log()로 로그를 기록합니다.");
    this.Text("DVRCF.logsEmpty",        "이번 세션에는 아직 로그가 없습니다.");
    this.Text("DVRCF.opt.logs",              "로그");
    this.Text("DVRCF.opt.logTextScale",      "로그 글자 크기");
    this.Text("DVRCF.opt.logTextScale.tip",  "로그 뷰어에만 적용되는 글자 크기입니다. 일반 UI 및 글자 배율과 별도로 조정됩니다.");
    this.Text("DVRCF.presets",               "프리셋");
    this.Text("DVRCF.presetsTitle",          "프리셋");
    this.Text("DVRCF.presetSaveNew",         "현재 설정을 다른 이름으로 저장...");
    this.Text("DVRCF.namePrompt",            "이름:");
    this.Text("DVRCF.opt.showFavorites",     "즐겨찾기 별표 표시");
    this.Text("DVRCF.opt.showFavorites.tip", "모드 목록에 즐겨찾기 별표를 표시하고 즐겨찾기를 먼저 정렬합니다. 끄면 별표를 숨기고 일반 정렬만 사용하며 저장된 즐겨찾기는 유지됩니다.");
    this.Text("DVRCF.opt.collections",       "컬렉션");
    this.Text("DVRCF.opt.colCreate",         "컬렉션 만들기");
    this.Text("DVRCF.opt.colCreateHint",     "클릭하여 새 컬렉션 만들기");
    this.Text("DVRCF.opt.colCreate.tip",     "저장된 모드 프리셋을 모드당 하나씩 선택해 이름 있는 컬렉션으로 묶고, 한 번에 모두 불러옵니다.");
    this.Text("DVRCF.opt.colHint",           "모드마다 프리셋을 최대 하나씩 선택한 뒤 저장하세요. 프리셋은 각 모드 페이지의 프리셋 버튼에서 만들 수 있습니다.");
    this.Text("DVRCF.opt.colSave",           "컬렉션 저장...");
    this.Text("DVRCF.load",                  "불러오기");
    this.Text("DVRCF.delete",                "삭제");
    this.Text("DVRCF.remove",                "제거");
    this.Text("DVRCF.opt.colEmpty",          "이 컬렉션은 비어 있습니다.");
    this.Text("DVRCF.opt.colMissing",        "누락");
    this.Text("DVRCF.opt.wikiTuning",        "위키 세부 조정");
    this.Text("DVRCF.opt.wikiNoWrap",        "코드: 줄 바꿈 없음으로 계산");
    this.Text("DVRCF.opt.wikiNoWrap.tip",    "코드 상자 높이를 원본 줄 수만으로 계산합니다. 긴 코드 줄이 실제 게임에서 줄 바꿈되는지 확인하려면 켜세요. 이 상태에서 상자 높이가 정확하면 줄 바꿈되지 않는 것입니다.");
    this.Text("DVRCF.opt.wikiCharNarrow",    "코드: 좁은 문자 너비(em)");
    this.Text("DVRCF.opt.wikiCharWide",      "코드: 넓은 문자 너비(em)");
    this.Text("DVRCF.opt.wikiCharBase",      "코드: 기본 문자 너비(em)");
    this.Text("DVRCF.opt.wikiLineFactor",    "코드: 줄 높이(em)");
    this.Text("DVRCF.opt.wikiScrollScale",   "목차: 이동 거리 배율");
    this.Text("DVRCF.opt.wikiScrollScale.tip", "목차 항목을 클릭할 때 이동하는 거리의 배율입니다. 이동 위치가 항상 목표보다 짧거나 길면 조정하세요. 결과는 RedRCFInput 로그에도 기록됩니다.");
    this.Text("DVRCF.opt.gamepad",      "게임패드용 버튼(슬라이더 - / +)");
    this.Text("DVRCF.opt.rememberPos",  "마지막 위치 기억");
    this.Text("DVRCF.opt.frameworkTint",     "프레임워크별 모드 색상");
    this.Text("DVRCF.opt.frameworkTint.tip", "목록의 각 모드에 프레임워크별 색상을 적용합니다. 빨간색 = RCF, 주황색 = Mod Settings, 녹색 = Native Settings입니다.");
    this.Text("DVRCF.opt.filterBoxShow",      "필터 입력창 표시");
    this.Text("DVRCF.opt.filterBoxShow.tip",  "모드 목록 왼쪽 아래에 모드 이름 필터 입력창을 표시합니다. 끄면 완전히 숨깁니다.");
    this.Text("DVRCF.opt.filterBoxHover",     "마우스 오버 시 필터 표시");
    this.Text("DVRCF.opt.filterBoxHover.tip", "마우스를 올리기 전에는 필터 입력창을 흐리게 표시합니다. 입력창에 초점이 있거나 필터가 적용된 동안에는 선명하게 유지됩니다. 필터 입력창 표시 옵션을 켜야 합니다.");
    this.Text("DVRCF.opt.filterFade",         "대기 중 필터 불투명도");
    this.Text("DVRCF.opt.filterFade.tip",     "마우스 오버 시 표시 모드에서 대기 중인 필터 입력창의 흐린 정도입니다. 마우스를 올리면 완전히 선명해집니다. 기본값은 0.40입니다.");
    this.Text("DVRCF.opt.textWidth",        "글자 너비");
    this.Text("DVRCF.opt.classicCharWidth", "클래식 탭 글자 너비");
    this.Text("DVRCF.opt.classicCharWidth.tip", "클래식 스타일 탭 라벨의 글자당 픽셀 너비입니다. 기본값은 22입니다. 키릴 문자 사용 시 좌우 여백이 과도하면 약 14~16으로 낮추십시오.");
    this.Text("DVRCF.opt.buttonCharWidth",  "버튼 글자 너비");
    this.Text("DVRCF.opt.buttonCharWidth.tip", "기능 버튼의 글자당 픽셀 너비입니다. 기본값은 22입니다. 키릴 문자 사용 시 약 14~16으로 낮추십시오.");

    this.Text("DVRCF.opt.layout",           "레이아웃");
    this.Text("DVRCF.opt.navFitFactor",     "하위 카테고리 맞춤 너비");
    this.Text("DVRCF.opt.navFitFactor.tip", "하위 카테고리 이름이 축소되기 전까지 차지할 것으로 계산하는 너비입니다. 값이 높을수록 이름이 더 늦게, 덜 자주 축소됩니다. 기본값은 1.40입니다.");
    this.Text("DVRCF.opt.tileFitFactor",     "모드 목록 맞춤 너비");
    this.Text("DVRCF.opt.tileFitFactor.tip", "모드 목록에서 이름이 축소되기 전까지 차지할 것으로 계산하는 너비입니다. 값이 높을수록 이름이 더 늦게, 덜 축소됩니다. 기본값은 1.32입니다.");
    this.Text("DVRCF.opt.navMinSize",       "하위 카테고리 최소 크기");
    this.Text("DVRCF.opt.navMinSize.tip",   "하위 카테고리 이름이 축소될 수 있는 최소 글자 크기입니다. 이 크기보다 작아져야 하면 더 축소하지 않고 두 줄로 표시합니다. 기본값은 22입니다.");
    this.Text("DVRCF.opt.ctrlOffset",       "컨트롤 열 간격");
    this.Text("DVRCF.opt.ctrlOffset.tip",   "라벨에서 컨트롤 및 값 열을 오른쪽으로 얼마나 떨어뜨릴지(px) 정합니다. 값이 높을수록 긴 라벨과의 간격이 넓어집니다. 기본값은 160입니다.");
    this.Text("DVRCF.opt.columnFirst",      "열 우선 채우기");
    this.Text("DVRCF.opt.columnFirst.tip",  "모드 목록 순서입니다. 꺼짐은 각 행을 왼쪽에서 오른쪽으로 채웁니다(모드1 모드2 모드3). 켜짐은 왼쪽 열을 위에서 아래로 먼저 채운 뒤 다음 열로 이동합니다. 기본값은 꺼짐입니다.");
    this.Text("DVRCF.opt.imgPortraitMax",     "세로 이미지 최대 높이");
    this.Text("DVRCF.opt.imgPortraitMax.tip", "위키 페이지에서 세로로 긴 이미지의 최대 표시 높이(px)입니다. 가로로 넓은 이미지는 항상 페이지 너비에 맞춥니다. 기본값은 600입니다.");
    this.Text("DVRCF.opt.uiMenuEntryBig",     "Big UI - 메뉴 버튼");
    this.Text("DVRCF.opt.uiMenuEntryBig.tip", "메인 메뉴의 RCF 설정 버튼에서 열 때 최대화된 카드 UI를 사용합니다. 왼쪽에는 카테고리 목록, 오른쪽에는 헤더 이미지와 설명이 있는 큰 모드 카드가 표시됩니다. 끄면 컴팩트 타일 그리드를 사용합니다. 다음에 열 때 적용됩니다. 기본값은 켜짐입니다.");
    this.Text("DVRCF.opt.uiMenuHotkeyBig",     "Big UI - 메뉴 단축키");
    this.Text("DVRCF.opt.uiMenuHotkeyBig.tip", "메인 메뉴에서 단축키로 열 때 최대화된 카드 UI를 사용합니다. 다음에 열 때 적용됩니다. 기본값은 켜짐입니다.");
    this.Text("DVRCF.opt.uiInGameBig",     "Big UI - 인게임");
    this.Text("DVRCF.opt.uiInGameBig.tip", "게임 안에서 열 때(단축키, 일시정지 메뉴 또는 다른 모드의 바로가기) 최대화된 카드 UI를 사용합니다. 다음에 열 때 적용됩니다. 기본값은 켜짐입니다.");
    this.Text("DVRCF.opt.bigFitNames",     "Big UI - 긴 모드 이름 축소");
    this.Text("DVRCF.opt.bigFitNames.tip", "꺼짐(기본값): 공간이 충분한 Big UI에서는 모든 모드 이름을 원래 크기로 유지합니다. 켜짐: 긴 이름을 카드나 탐색 행에 맞게 축소합니다. 컴팩트 모드 타일은 설정과 관계없이 항상 공간에 맞게 축소됩니다.");
    this.Text("DVRCF.opt.overlayDark",     "어두운 오버레이");
    this.Text("DVRCF.opt.overlayDark.tip", "검색, 정렬, 초기화, 프리셋 대화상자 뒤에 흰색 대신 검은색 배경을 사용합니다. 밝은 화면이나 대형 TV에서 눈부심을 줄여 줍니다. 기본값은 켜짐입니다.");
    this.Text("DVRCF.pagePrev", "< 이전");
    this.Text("DVRCF.pageNext", "다음 >");
    this.Text("DVRCF.page",     "페이지");
    this.Text("DVRCF.opt.pregameFlat",     "평면 메인 메뉴 창");
    this.Text("DVRCF.opt.pregameFlat.tip", "켜짐: 메인 메뉴 창을 어두운 배경 위에 평면으로 표시합니다(어안 효과 없음). 꺼짐: 도시 배경을 유지한 채 게임의 곡면 메뉴 스타일로 표시합니다. 다음에 열 때 적용됩니다. 기본값은 켜짐입니다.");
    this.Text("DVRCF.cat.title", "카테고리");
    this.Text("DVRCF.cat.all",   "모든 모드");
    this.Text("DVRCF.cat.other", "미분류");
