module MuchBetterAI.Localization.Packages
import Codeware.Localization.*

public class Korean extends ModLocalizationPackage {
  protected func DefineTexts() -> Void {
    this.Text("UI-MBAI-Tab", "Much Better AI");

    this.Text("Category-MBAI-Marksmanship", "사격술");
    this.Text("Category-MBAI-Footwork", "기동");
    this.Text("Category-MBAI-Punish", "취약 순간 압박");
    this.Text("Category-MBAI-Fireteam", "분대 전술");
    this.Text("Category-MBAI-Nerve", "신경");
    this.Text("Category-MBAI-Archetypes", "전투 유형");
    this.Text("Category-MBAI-Capability", "적 능력");
    this.Text("Category-MBAI-Aggression", "공격성 하한");
    this.Text("Category-MBAI-Stealth", "은신");
    this.Text("Category-MBAI-Acoustics", "플레이어 소음");
    this.Text("Category-MBAI-Sensors", "감지 장치");
    this.Text("Category-MBAI-Netrunner", "넷러너");
    this.Text("Category-MBAI-Debug", "디버그");

    this.Text("DisplayName-MBAI-MarksmanshipHitModelMode", "명중 판정 방식");
    this.Text("Description-MBAI-MarksmanshipHitModelMode", "전체 MBAI는 시야, 거리, 명중률 조건을 통과한 뒤 사격 품질에 따라 명중 여부를 판정합니다. 필터 전용은 바닐라의 명중 허용 판정을 사용한 뒤 MBAI 사격 품질을 적용합니다. 외부 모드 / 끄기는 명중 판정을 기본 게임이나 다른 모드에 맡깁니다. Immersive Shooting AI가 감지되면 자동으로 해당 모드에 명중 판정을 맡깁니다.");
    this.Text("DisplayName-MBAI-MarksmanshipCadence", "사격 패턴");
    this.Text("Description-MBAI-MarksmanshipCadence", "적 등급, 무기 종류 또는 현재 제압 임무에 따라 MBAI의 점사 타이밍을 조정합니다. 끄면 MBAI가 사격 패턴 패키지를 선택하지 않습니다.");
    this.Text("DisplayName-MBAI-MarksmanshipFirstShotWindup", "초탄 준비 시간");
    this.Text("Description-MBAI-MarksmanshipFirstShotWindup", "팩션의 반응 속도와 현재 전투 의도에 따라 초탄 지연 시간을 조정합니다. 끄면 선택된 패턴이나 다른 모드가 초탄 타이밍을 결정합니다.");
    this.Text("DisplayName-MBAI-MarksmanshipAccuracy", "정밀도");
    this.Text("Description-MBAI-MarksmanshipAccuracy", "기본 명중 압박을 조절합니다. 이동, 시야 및 기타 상황에 따른 불이익은 별도로 적용됩니다. 1.6이 기본값이며 높을수록 위험합니다.");
    this.Text("DisplayName-MBAI-MarksmanshipReactionGrace", "반응 유예 시간");
    this.Text("Description-MBAI-MarksmanshipReactionGrace", "적이 최대 명중률에 도달하기 전의 초기 유예 시간을 조정합니다. 0은 유예를 끄고, 1.0이 기본값이며 높을수록 대응 시간이 길어집니다.");
    this.Text("DisplayName-MBAI-MarksmanshipSquadFocusProtection", "분대 집중 사격 완화");
    this.Text("Description-MBAI-MarksmanshipSquadFocusProtection", "짧은 시간 안에 처음 두 발이 명중한 뒤 이어지는 명중을 완화합니다. 0은 보호를 끄고, 1.0이 기본 강도입니다.");
    this.Text("DisplayName-MBAI-MarksmanshipVehicleAccuracy", "주행 중 명중률 완화");
    this.Text("Description-MBAI-MarksmanshipVehicleAccuracy", "V가 운전하거나 동승한 차량의 속도가 빨라질수록 적의 명중 확률이 감소합니다. 정차 중이거나 느리게 움직이는 차량에는 적용되지 않습니다. Immersive Shooting AI가 설치된 경우 해당 모드가 우선 적용됩니다.");
    this.Text("DisplayName-MBAI-MarksmanshipVehicleCarHitCeiling", "고속 자동차 피격률 상한(%)");
    this.Text("Description-MBAI-MarksmanshipVehicleCarHitCeiling", "자동차가 보호 효과를 최대로 받는 속도에서 적용되는 적 명중률 상한입니다. 20이 기본값이며, 100으로 설정하면 자동차 주행 중 명중률 상한이 사라집니다.");
    this.Text("DisplayName-MBAI-MarksmanshipVehicleBikeHitCeiling", "고속 바이크 피격률 상한(%)");
    this.Text("Description-MBAI-MarksmanshipVehicleBikeHitCeiling", "바이크가 보호 효과를 최대로 받는 속도에서 적용되는 적 명중률 상한입니다. 40이 기본값이며, 100으로 설정하면 바이크 주행 중 명중률 상한이 사라집니다.");
    this.Text("DisplayName-MBAI-FootworkMovePolicy", "거리 유지 및 추적");
    this.Text("Description-MBAI-FootworkMovePolicy", "적 등급과 현재 전투 의도에 따라 전투 거리 허용 범위와 좌우 이동 예측을 조정합니다. 끄면 기본 게임이나 다른 모드가 이동 정책을 결정합니다.");
    this.Text("DisplayName-MBAI-FootworkOpportunityReposition", "사격 각도 재배치");
    this.Text("Description-MBAI-FootworkOpportunityReposition", "사격 각도가 계속 나쁘거나 무기 사거리에 적합하지 않은 원거리 적은 도달할 수 있는 더 나은 위치를 찾습니다.");
    this.Text("DisplayName-MBAI-FootworkThreatEvade", "조준 위협 회피");
    this.Text("Description-MBAI-FootworkThreatEvade", "조준선을 적에게 계속 맞추고 있으면 적이 가끔 조준 밖으로 뛰어 피합니다. 다음 게임 로드부터 적용됩니다.");
    this.Text("DisplayName-MBAI-FootworkIncomingFire", "근접 탄착 반응");
    this.Text("Description-MBAI-FootworkIncomingFire", "적 주변에 탄환이 계속 박히면 바닐라 전투 판단을 다시 수행합니다. 팩션과 등급에 따라 반응 속도가 달라지며, 빗나간 사격만으로 공황이나 엄폐 행동을 강제로 유발하지는 않습니다.");
    this.Text("DisplayName-MBAI-FootworkEvades", "좌우 회피");
    this.Text("Description-MBAI-FootworkEvades", "전투 중 좌우 이동을 더 자주 보이게 합니다. 다음 게임 로드부터 적용됩니다.");
    this.Text("DisplayName-MBAI-FootworkCatchUp", "추격 질주");
    this.Text("Description-MBAI-FootworkCatchUp", "적이 플레이어를 압박해야 할 때 마지막 12m를 질주해 좁힙니다. 다음 게임 로드부터 적용됩니다.");
    this.Text("DisplayName-MBAI-EnableCoverSeeking", "엄폐 지점 탐색(스파이크)");
    this.Text("Description-MBAI-EnableCoverSeeking", "사격을 받아 엄폐물이 무너지는 적은 현재 위치를 이탈해 새 엄폐 지점을 찾습니다. 등급에 따라 엘리트는 빠르게 이탈하고, 일반 적은 더 오래 버팁니다.");
    this.Text("DisplayName-MBAI-FootworkVerticalityPush", "고지대 대응 전술");
    this.Text("Description-MBAI-FootworkVerticalityPush", "분대 전술이 필요합니다. 플레이어가 접근 불가능한 고지대를 점거하면 분대는 노출된 기동을 중단하고 사격 각도를 차단하며, 가장 가까운 접근 가능한 경로를 봉쇄합니다. 접근 가능한 옥상은 일반 전투 공간으로 취급합니다.");
    this.Text("DisplayName-MBAI-PunishReload", "재장전 응징");
    this.Text("Description-MBAI-PunishReload", "시야 안에서 플레이어가 재장전하는 모습을 본 공격적인 적이 거리를 좁혀 압박합니다.");
    this.Text("DisplayName-MBAI-PunishHeal", "회복 응징");
    this.Text("Description-MBAI-PunishHeal", "플레이어가 회복 아이템을 사용하는 모습을 본 공격적인 적이 거리를 좁혀 압박합니다.");
    this.Text("DisplayName-MBAI-PunishStamina", "스태미나 고갈 응징");
    this.Text("Description-MBAI-PunishStamina", "플레이어의 스태미나가 고갈되면 공격적인 적이 거리를 좁혀 압박합니다.");
    this.Text("DisplayName-MBAI-PunishMeleeDefense", "막기 및 패링 응징");
    this.Text("Description-MBAI-PunishMeleeDefense", "근접한 상태에서 플레이어가 공격을 막거나 패링하면 근접 적이 이어서 압박합니다. 다음 게임 로드부터 적용됩니다.");
    this.Text("DisplayName-MBAI-PunishChanceMult", "응징 빈도");
    this.Text("Description-MBAI-PunishChanceMult", "적이 빈틈을 포착했을 때 압박하는 빈도입니다. 1.15가 기본값입니다.");
    this.Text("DisplayName-MBAI-FireteamSuppression", "제압 사격");
    this.Text("Description-MBAI-FireteamSuppression", "일부 분대원을 기동조가 움직이는 동안 화력 지원을 유지하도록 지정합니다.");
    this.Text("DisplayName-MBAI-SuppressedAccuracyMult", "제압 사격 명중률");
    this.Text("Description-MBAI-SuppressedAccuracyMult", "플레이어를 제압하도록 지정된 적의 명중률 배율입니다. 0.3이 기본값이며, 1.0은 엄호 사격 페널티를 제거합니다. MBAI 명중 판정 방식이 필요합니다.");
    this.Text("DisplayName-MBAI-FireteamFlank", "측면 기동");
    this.Text("Description-MBAI-FireteamFlank", "적이 대열에서 이탈해 플레이어의 후방으로 질주하여 엄폐 밖으로 몰아냅니다.");
    this.Text("DisplayName-MBAI-FireteamFlankMult", "측면 기동 빈도");
    this.Text("Description-MBAI-FireteamFlankMult", "적이 대열에서 이탈해 측면을 공략하거나 플레이어 위치로 돌격하는 빈도입니다. 1.25가 기본값입니다.");
    this.Text("DisplayName-MBAI-FireteamBounding", "교대 엄호 전진");
    this.Text("Description-MBAI-FireteamBounding", "반응형 전술을 사용하는 분대가 한 조는 전진하고 다른 조는 자리를 지켜 엄호하는 방식으로 교대로 전진합니다.");
    this.Text("DisplayName-MBAI-FireteamGrenades", "수류탄 전술");
    this.Text("Description-MBAI-FireteamGrenades", "적이 보유한 수류탄을 서로 조율해 사용해, 방해 공격을 중복시키지 않으면서 한곳의 엄폐물에 머무는 플레이어를 몰아냅니다.");
    this.Text("DisplayName-MBAI-FireteamAnchors", "거점 유지");
    this.Text("Description-MBAI-FireteamAnchors", "전술에 따라 지정된 거점 담당이 유리한 사격 위치를 유지하는 동안 기동조가 이동합니다.");
    this.Text("DisplayName-MBAI-FireteamCombatPropagation", "인근 지원군");
    this.Text("Description-MBAI-FireteamCombatPropagation", "근처의 같은 팩션 적이 분대나 합류 인원 제한 없이 진행 중인 전투에 참여할 수 있습니다. 우호적인 인물과 스크립트상 비전투 인물은 제외됩니다.");
    this.Text("DisplayName-MBAI-FireteamCombatPropagationRange", "지원군 범위");
    this.Text("Description-MBAI-FireteamCombatPropagationRange", "근처의 적이 전투 중인 아군에게 합류할 수 있는 최대 거리입니다. 30이 기본값입니다.");
    this.Text("DisplayName-MBAI-NerveCasualtyPressure", "사상자 압박");
    this.Text("Description-MBAI-NerveCasualtyPressure", "분대원이 사망하면 생존자의 사기가 더 빨리 무너집니다. 끄면 각 적의 체력만으로 사기 붕괴 여부를 판단합니다.");
    this.Text("DisplayName-MBAI-NerveWitnessContagion", "공포 전염");
    this.Text("Description-MBAI-NerveWitnessContagion", "분대원의 죽음을 실제로 목격한 주변 적에게 공포가 전염됩니다. 지휘관이 죽으면 더 강하고 넓은 범위에 영향을 줍니다. 공포를 느끼지 않는 팩션은 여전히 사기가 무너지지 않습니다.");
    this.Text("DisplayName-MBAI-NerveContagionStrength", "공포 전염 강도");
    this.Text("Description-MBAI-NerveContagionStrength", "아군의 죽음을 목격한 적의 사기 붕괴를 앞당기는 추가 강도입니다. 0.20이 기본값입니다.");
    this.Text("DisplayName-MBAI-NerveBreakThreshold", "사기 붕괴 지점");
    this.Text("Description-MBAI-NerveBreakThreshold", "적이 얼마나 쉽게 평정심을 잃는지 조절합니다. 반응은 팩션·역할·기동성에 따라 달라집니다. 0.85가 기본값입니다. 공포를 느끼지 않는 팩션은 사기가 무너지지 않습니다.");
    this.Text("DisplayName-MBAI-ArchetypeTemperament", "성향 배정");
    this.Text("Description-MBAI-ArchetypeTemperament", "전투 역할, 팩션, 성격, 지휘관 존재 여부에 따라 신중, 방어, 균형, 공격, 무모 성향을 배정합니다. 교리 제어가 종료되면 각 적의 원래 지정된 성향으로 복원합니다.");
    this.Text("DisplayName-MBAI-ArchetypeWeaponRhythm", "무기별 사격 리듬");
    this.Text("Description-MBAI-ArchetypeWeaponRhythm", "저격총, 산탄총, 중화기, 기관단총에 대해 등급별 사격 패턴 대신 무기 종류별 리듬을 적용합니다. 사격술의 사격 패턴이 필요합니다.");
    this.Text("DisplayName-MBAI-ArchetypeRingDiscipline", "교전 거리 규율");
    this.Text("Description-MBAI-ArchetypeRingDiscipline", "무기별 거리 구간 선택 필터로 각 무기 유형이 선호 거리 근처를 유지하게 합니다. 다음 게임 로드부터 적용됩니다.");
    this.Text("DisplayName-MBAI-AggressionRingCaps", "동시 공격 인원");
    this.Text("Description-MBAI-AggressionRingCaps", "V와 싸우는 준비된 적들이 함께 공격하고 접근할 수 있게 합니다. 각 적의 공격 회복 시간과 거리 조건은 유지되며, 팩션별 선택도 유지됩니다. 인원 조정은 다음 게임 로드부터 적용됩니다.");
    this.Text("DisplayName-MBAI-AggressionStrafeCadence", "좌우 이동 주기");
    this.Text("Description-MBAI-AggressionStrafeCadence", "좌우 회피 재사용 대기시간을 줄여 적이 사격 사이에 더 자주 위치를 바꾸게 합니다. 다음 게임 로드부터 적용됩니다.");
    this.Text("DisplayName-MBAI-StealthDetection", "감지");
    this.Text("Description-MBAI-StealthDetection", "MBAI의 탐지 속도 보정은 바닐라보다 낮아지지 않습니다. 거리, 이동, 엄폐, 시간대, 적 등급, 최근 식별 여부에 따라 추가 탐지 압박이 달라집니다. 설치된 기본 설정은 경계 또는 전투 상태의 적에게 50m 시야를 부여하며, 이 범위는 해당 옵션으로 조절할 수 없습니다.");
    this.Text("DisplayName-MBAI-StealthSearch", "수색 및 배회");
    this.Text("Description-MBAI-StealthSearch", "플레이어를 놓친 경계 상태의 적이 주변을 배회하고, 한 명은 마지막으로 확인한 위치를 향해 추적합니다.");
    this.Text("DisplayName-MBAI-StealthTriggers", "경보 발동");
    this.Text("Description-MBAI-StealthTriggers", "적대 또는 제한 구역에서 발각되면 적 한 명이 조사하러 오며, 카메라나 터렛은 가장 가까운 경비를 호출합니다.");
    this.Text("DisplayName-MBAI-StealthAlerts", "경계 지속 시간");
    this.Text("Description-MBAI-StealthAlerts", "전투, 시체, 총성 또는 소음 이후 적이 경계 상태로 수색하는 시간을 조정합니다.");
    this.Text("DisplayName-MBAI-StealthBodies", "시체 발견");
    this.Text("Description-MBAI-StealthBodies", "적이 시체를 명확하게 볼 수 있을 때만 발견하며, 한 번 발견되면 해당 구역은 장시간 경계 상태를 유지합니다.");
    this.Text("DisplayName-MBAI-StealthTakedowns", "테이크다운 반응");
    this.Text("Description-MBAI-StealthTakedowns", "주변 적은 잡기와 테이크다운 소리가 나면 조사하러 옵니다. 직접 목격한 적은 감지율이 10%에 도달하면 즉시 전투 상태로 전환합니다.");
    this.Text("DisplayName-MBAI-StealthHitResponse", "은신 피격 반응");
    this.Text("Description-MBAI-StealthHitResponse", "보이지 않는 적이 첫 은밀 공격에 부상을 입으면 정확한 위치를 알지 못한 채 주변 분대에 경보를 보내고 수색합니다. 후속 공격이나 자동 사격을 받으면 전투가 시작됩니다.");
    this.Text("DisplayName-MBAI-StealthHitResponseWindow", "후속 공격 유효 시간");
    this.Text("Description-MBAI-StealthHitResponseWindow", "첫 은밀 공격 후 추가 공격이 전투로 확대되는 시간입니다. 2.0초가 기본값입니다.");
    this.Text("DisplayName-MBAI-StealthDetectionStrength", "감지 강도");
    this.Text("Description-MBAI-StealthDetectionStrength", "MBAI의 전반적인 탐지 압박을 조절합니다. 3.0이 기본값, 10.0이 최댓값입니다. 바닐라 또는 더 강한 외부 탐지 효과를 약화시키지는 않습니다.");
    this.Text("DisplayName-MBAI-StealthAlertedMult", "경계 상태 감지 속도");
    this.Text("Description-MBAI-StealthAlertedMult", "경계 상태의 적이 V를 탐지하는 속도 배율입니다. 2.5가 기본값입니다.");
    this.Text("DisplayName-MBAI-StealthInvestigatingMult", "조사 중 감지 속도");
    this.Text("Description-MBAI-StealthInvestigatingMult", "의심 지점을 조사하러 이동 중인 적이 V를 탐지하는 속도 배율입니다. 1.5가 기본값입니다.");
    this.Text("DisplayName-MBAI-StealthNightBonus", "야간 은신 보너스");
    this.Text("Description-MBAI-StealthNightBonus", "밤에 플레이어가 얼마나 더 발견되기 어려운지 조정합니다. 낮을수록 은신에 유리합니다.");
    this.Text("DisplayName-MBAI-StealthHeightenedMult", "긴장 상태 감지 속도");
    this.Text("Description-MBAI-StealthHeightenedMult", "전투 종료 후 적이 예민해진 동안 적용되는 탐지 속도 배율입니다. 2.0이 기본값이며, 경계 강화 지속 시간에 걸쳐 1.0까지 감소합니다.");
    this.Text("DisplayName-MBAI-StealthHeightenedWindow", "긴장 유지 시간");
    this.Text("Description-MBAI-StealthHeightenedWindow", "전투가 끝나거나 수색이 종료된 뒤 적이 긴장 상태를 유지하는 시간입니다. 60초가 기본값입니다.");
    this.Text("DisplayName-MBAI-StealthSearchAggression", "수색 적극성");
    this.Text("Description-MBAI-StealthSearchAggression", "수색자가 수색 대상에게 얼마나 가까이 접근하는지 조절합니다. 알려진 단서를 먼저 추적하고, 단서가 없으면 V의 현재 구역을 수색합니다. 0은 넓은 범위 접근, 1은 가까이 접근입니다. 0.85가 기본값입니다.");
    this.Text("DisplayName-MBAI-SearchOnSightScanRange", "주변 조사 범위");
    this.Text("Description-MBAI-SearchOnSightScanRange", "플레이어 주변에서 아직 경계하지 않은 적을 확인해 조사 행동을 시작시키는 범위입니다. 30이 기본값입니다.");
    this.Text("DisplayName-MBAI-CameraLinkRange", "카메라 경보 범위");
    this.Text("Description-MBAI-CameraLinkRange", "주변의 카메라와 터렛이 스캔하고 가장 가까운 경비에게 정보를 전달할 수 있는 범위입니다. 40이 기본값입니다.");
    this.Text("DisplayName-MBAI-SearchDangerousThreshold", "조사 전환 임계값(위험 구역)");
    this.Text("Description-MBAI-SearchDangerousThreshold", "위험 구역에서 적이 조사에 나서기 전에 감지 게이지가 채워져야 하는 비율입니다. 0.05가 기본값입니다.");
    this.Text("DisplayName-MBAI-SearchRestrictedThreshold", "조사 전환 임계값(제한 구역)");
    this.Text("Description-MBAI-SearchRestrictedThreshold", "제한 구역에서 적이 조사에 나서기 전에 감지 게이지가 채워져야 하는 비율입니다. 0.25가 기본값입니다.");
    this.Text("DisplayName-MBAI-StealthAlertDurCombat", "경계 지속 시간: 전투 해제");
    this.Text("Description-MBAI-StealthAlertDurCombat", "전투 상태가 해제된 뒤 적이 수색하는 시간입니다. 90초가 기본값입니다.");
    this.Text("DisplayName-MBAI-StealthAlertDurBody", "경계 지속 시간: 시체 발견");
    this.Text("Description-MBAI-StealthAlertDurBody", "적이 시체를 발견한 뒤 해당 구역이 수색하는 시간입니다. 60초가 기본값입니다.");
    this.Text("DisplayName-MBAI-StealthAlertDurGunshot", "경계 지속 시간: 소음기 총성");
    this.Text("Description-MBAI-StealthAlertDurGunshot", "주변 적이 소음기 총성을 들은 뒤 수색하는 시간입니다. 30초가 기본값입니다.");
    this.Text("DisplayName-MBAI-StealthAlertDurDefault", "경계 지속 시간: 기타");
    this.Text("Description-MBAI-StealthAlertDurDefault", "그 밖의 경보 이후 적이 수색하는 시간입니다. 20초가 기본값입니다.");
    this.Text("DisplayName-MBAI-StealthCombatDropSeconds", "전투 해제 시간");
    this.Text("Description-MBAI-StealthCombatDropSeconds", "분대가 시야를 잃은 뒤 전투 상태가 해제되기까지 필요한 시간입니다. 15초가 기본값입니다.");
    this.Text("DisplayName-MBAI-StealthCombatDropLatDist", "전투 해제: 수평 거리");
    this.Text("Description-MBAI-StealthCombatDropLatDist", "전투 상태가 해제되려면 마지막으로 목격된 위치에서 떨어져야 하는 수평 거리입니다. 25m가 기본값입니다.");
    this.Text("DisplayName-MBAI-StealthCombatDropVertDist", "전투 해제: 수직 거리");
    this.Text("Description-MBAI-StealthCombatDropVertDist", "전투 상태 해제를 유발하는 수직 이동 거리입니다. 3m가 기본값입니다.");
    this.Text("DisplayName-MBAI-StealthThreatMemory", "위협 기억");
    this.Text("Description-MBAI-StealthThreatMemory", "수색을 포기한 뒤 적이 의심 상태를 유지하는 시간입니다. 90초가 기본값이며, 0은 바닐라입니다. 게임 로드 시 적용됩니다.");
    this.Text("DisplayName-MBAI-GrappleNoiseRange", "잡기 소음 범위");
    this.Text("Description-MBAI-GrappleNoiseRange", "처음 붙잡을 때와 몸부림치는 소리를 적이 들을 수 있는 거리입니다. 6이 기본값입니다.");
    this.Text("DisplayName-MBAI-TakedownNoiseRange", "테이크다운 소음 범위");
    this.Text("Description-MBAI-TakedownNoiseRange", "마무리 충격음을 적이 들을 수 있는 거리입니다. 8이 기본값입니다.");
    this.Text("DisplayName-MBAI-AcousticMovement", "이동 소음");
    this.Text("Description-MBAI-AcousticMovement", "이동, 회피, 대시, 점프, 착지로 발생하는 소음을 제어합니다.");
    this.Text("DisplayName-MBAI-AcousticFootsteps", "발소리, 회피 및 대시");
    this.Text("Description-MBAI-AcousticFootsteps", "발소리, 회피, 대시 소음을 활성화합니다.");
    this.Text("DisplayName-MBAI-AcousticJumpLanding", "점프 및 착지");
    this.Text("Description-MBAI-AcousticJumpLanding", "점프와 착지 소음을 활성화합니다.");
    this.Text("DisplayName-MBAI-AcousticMovementScale", "이동 소음 범위 배율");
    this.Text("Description-MBAI-AcousticMovementScale", "이동 소리가 전달되는 거리를 조정합니다. 1.0이 기본값입니다.");
    this.Text("DisplayName-MBAI-AcousticInteraction", "상호작용 소음");
    this.Text("Description-MBAI-AcousticInteraction", "문, 라디오 및 기타 상호작용으로 발생하는 소음을 제어합니다.");
    this.Text("DisplayName-MBAI-AcousticDoors", "문");
    this.Text("Description-MBAI-AcousticDoors", "문을 열고 닫을 때 발생하는 소음을 활성화합니다.");
    this.Text("DisplayName-MBAI-AcousticRadios", "라디오");
    this.Text("Description-MBAI-AcousticRadios", "라디오 사용 시 발생하는 소음을 활성화합니다.");
    this.Text("DisplayName-MBAI-AcousticInteractionScale", "상호작용 소음 범위 배율");
    this.Text("Description-MBAI-AcousticInteractionScale", "상호작용 소리가 전달되는 거리를 조정합니다. 1.0이 기본값입니다.");
    this.Text("DisplayName-MBAI-AcousticBody", "시체 처리 소음");
    this.Text("Description-MBAI-AcousticBody", "시체를 운반, 내려놓기, 숨기기, 처리할 때 발생하는 소음을 제어합니다.");
    this.Text("DisplayName-MBAI-AcousticCarryDrop", "운반 및 내려놓기");
    this.Text("Description-MBAI-AcousticCarryDrop", "시체를 운반하고 내려놓을 때 발생하는 소음을 활성화합니다.");
    this.Text("DisplayName-MBAI-AcousticDisposal", "숨기기 및 즉시 처리");
    this.Text("Description-MBAI-AcousticDisposal", "시체를 숨기거나 즉시 처리할 때 발생하는 소음을 활성화합니다.");
    this.Text("DisplayName-MBAI-AcousticBodyScale", "시체 처리 소음 범위 배율");
    this.Text("Description-MBAI-AcousticBodyScale", "시체 처리 소리가 전달되는 거리를 조정합니다. 1.0이 기본값입니다.");
    this.Text("DisplayName-MBAI-AcousticCombat", "전투 소음");
    this.Text("Description-MBAI-AcousticCombat", "플레이어가 전투 중 발생시키는 소음을 제어합니다.");
    this.Text("DisplayName-MBAI-StealthGunfire", "총성 반응");
    this.Text("Description-MBAI-StealthGunfire", "소음기를 장착한 무기를 발사하면 청각 범위 내의 비경계 적이 경계 상태로 전환하고, 큰 총성은 이미 경계 중인 적이 플레이어 쪽을 향하게 합니다.");
    this.Text("DisplayName-MBAI-AcousticCombatScale", "전투 소음 범위 배율");
    this.Text("Description-MBAI-AcousticCombatScale", "전투 소리가 전달되는 거리를 조정합니다. 1.0이 기본값입니다.");
    this.Text("DisplayName-MBAI-StealthNoiseReactions", "연계 소음 반응");
    this.Text("Description-MBAI-StealthNoiseReactions", "빗나간 투척 나이프, 떨어뜨린 시체 또는 시체 은닉 소리를 조사하도록 주변 적 한 명을 보냅니다.");
    this.Text("DisplayName-MBAI-SensorAlertedMult", "경계 상태 감지 속도");
    this.Text("Description-MBAI-SensorAlertedMult", "경계 상태인 보안 네트워크에 연결된 카메라와 터렛의 탐지 속도 배율입니다. 2.5가 기본값이며, 다음 감지 판정부터 적용됩니다.");
    this.Text("DisplayName-MBAI-SensorSafeMult", "안전 상태 감지 속도");
    this.Text("Description-MBAI-SensorSafeMult", "정상 상태의 보안 네트워크에 연결된 카메라와 터렛의 탐지 속도 배율입니다. 1.5가 기본값이며, 다음 감지 판정부터 적용됩니다.");
    this.Text("DisplayName-MBAI-NetrunnerFactionIdentity", "팩션 성향");
    this.Text("Description-MBAI-NetrunnerFactionIdentity", "적 넷러너가 소속 팩션에 맞는 퀵핵을 우선 사용합니다(부두 보이즈는 피해, 기업은 제어, 거리 갱단은 전투 준비용 교란, 스캐빈저는 사이버웨어 방해).");
    this.Text("DisplayName-MBAI-NetrunnerTierGating", "희귀도 등급 제한");
    this.Text("Description-MBAI-NetrunnerTierGating", "넷러너의 등급에 따라 사용할 수 있는 퀵핵을 제한합니다. 일반 넷러너는 기본 퀵핵만 사용하고, 엘리트만 강력한 퀵핵과 즉사급 퀵핵을 사용합니다.");
    this.Text("DisplayName-MBAI-EnableNetrunnerReposition", "생존 우선");
    this.Text("Description-MBAI-EnableNetrunnerReposition", "플레이어가 가까이 접근하면 적 넷러너가 퀵핵 사이에 시야를 끊고 더 안전한 위치로 이동합니다.");
    this.Text("DisplayName-MBAI-NetrunnerRepositionRange", "생존 우선 거리");
    this.Text("Description-MBAI-NetrunnerRepositionRange", "넷러너가 거리를 벌리기 시작하는 접근 거리입니다. 15가 기본값입니다.");
    this.Text("DisplayName-MBAI-NetrunnerAllowUltimates", "궁극 퀵핵 허용");
    this.Text("Description-MBAI-NetrunnerAllowUltimates", "적 넷러너가 즉사급 퀵핵을 사용할 수 있는지 설정합니다. 끄면 항상 일반 퀵핵으로 하향됩니다.");
    this.Text("DisplayName-MBAI-NetrunnerCadenceMult", "퀵핵 빈도");
    this.Text("Description-MBAI-NetrunnerCadenceMult", "적 넷러너가 전반적으로 퀵핵을 사용하는 빈도입니다. 0.85가 기본값이며, 높을수록 드물고 낮을수록 자주 사용합니다.");
    this.Text("DisplayName-MBAI-DebugExaggerate", "등급 과장");
    this.Text("Description-MBAI-DebugExaggerate", "각 시스템의 차이가 눈에 띄도록 등급 차이를 과장된 수준으로 높입니다. 밸런스용이 아닌 검증용입니다.");
    this.Text("DisplayName-MBAI-EnableDebugLog", "디버그 로그 활성화");
    this.Text("Description-MBAI-EnableDebugLog", "디버그 출력의 전체 스위치입니다. 끄면 ERROR 등급만 출력됩니다.");
    this.Text("DisplayName-MBAI-EnableCombatAudit", "전투 검증 로그");
    this.Text("Description-MBAI-EnableCombatAudit", "검증을 위해 고빈도 전투 판단 로그를 기록합니다. 일반 플레이에서는 끄십시오.");
    this.Text("DisplayName-MBAI-DebugLogLevel", "디버그 로그 등급");
    this.Text("Description-MBAI-DebugLogLevel", "로그 상세도 단계입니다. ERROR < WARNING < INFO < DEBUG < TRACE 순이며, 각 단계는 이전 단계의 내용을 포함합니다.");
    this.Text("DisplayName-MBAI-EnableMarksmanship", "활성");
    this.Text("Description-MBAI-EnableMarksmanship", "MBAI의 사격 패턴과 선택적 탄별 명중 판정을 제어합니다. 명중 판정은 끄거나, 바닐라 명중만 필터링하거나, 전체 MBAI 압박 로직을 사용할 수 있습니다.");
    this.Text("DisplayName-MBAI-EnableFootwork", "활성");
    this.Text("Description-MBAI-EnableFootwork", "이동 전술입니다. 적 등급에 따른 거리 유지와 추적, 케렌지코프 회피, 추격 질주를 적용합니다. 선택 항목 기반의 이동 변경은 다음 게임 로드부터 적용됩니다.");
    this.Text("DisplayName-MBAI-EnablePunishWindows", "활성");
    this.Text("Description-MBAI-EnablePunishWindows", "공격적인 적이 플레이어의 재장전, 회복 또는 스태미나 고갈을 포착하면 압박합니다. 약한 적부터 엘리트까지 등급이 높을수록 발동 확률이 증가하며, 보스와 맥스택은 제외됩니다. 선택 사항인 막기 및 패링 압박은 다음 게임 로드부터 적용됩니다.");
    this.Text("DisplayName-MBAI-EnableFireteam", "활성");
    this.Text("Description-MBAI-EnableFireteam", "분대 전술입니다. 제압, 측면 기동, 교대 엄호 전진, 수류탄, 최종 확인 위치 추적, 거점 유지 명령을 적용합니다.");
    this.Text("DisplayName-MBAI-EnableNerve", "활성");
    this.Text("Description-MBAI-EnableNerve", "전세가 불리해지면 적의 사기가 무너져 엄폐로 후퇴합니다. 팩션에 따라 스캐빈저는 일찍 도주하고, 기업 세력과 맥스택은 오래 버티거나 무너지지 않으며, 애니멀은 절대 도주하지 않습니다.");
    this.Text("DisplayName-MBAI-EnableArchetypes", "활성");
    this.Text("Description-MBAI-EnableArchetypes", "무기별 사격 리듬과 전투 역할별 성향을 적용합니다. 사격 리듬에는 사격술의 사격 패턴이 필요하며, 적이 로드될 때 성향과 교전 거리 규율이 갱신됩니다.");
    this.Text("DisplayName-MBAI-EnableCapabilityDoctrine", "활성");
    this.Text("Description-MBAI-EnableCapabilityDoctrine", "적의 신체 능력입니다. 일부 근접 적은 방어를 무너뜨리고, 일반 적은 몸부림쳐 잡기에서 벗어날 수 있습니다. 원래 전투 자극제를 사용하던 원거리 적은 체력이 크게 떨어지면 회복할 수도 있습니다. 방어 파괴 대상은 적 개체가 다시 로드될 때 갱신됩니다. 야전 치료는 다음 게임 로드부터 적용됩니다.");
    this.Text("DisplayName-MBAI-CapabilityGuardBreak", "방어 파괴");
    this.Text("Description-MBAI-CapabilityGuardBreak", "일부 중장형·고속형 근접 적은 V가 유지 중인 방어를 무너뜨릴 수 있습니다. 대상은 적 개체가 다시 로드될 때 갱신됩니다.");
    this.Text("DisplayName-MBAI-CapabilityGrappleEscape", "잡기 탈출");
    this.Text("Description-MBAI-CapabilityGrappleEscape", "일반 적은 등급에 따라 정해진 시간이 지나면 몸부림쳐 잡기에서 벗어납니다. 고릴라 암즈를 사용하면 일반 등급 이하의 적을 무기한 붙잡을 수 있으며, 신체 수치가 높을수록 강한 적을 붙잡아 둘 수 있는 시간이 늘어납니다.");
    this.Text("DisplayName-MBAI-CapabilityFieldMedicine", "야전 치료");
    this.Text("Description-MBAI-CapabilityFieldMedicine", "원래 전투 자극제를 사용하던 원거리 적이 체력 30% 미만일 때 기존 회복 능력을 사용합니다. MBAI의 다른 명령을 수행 중일 때는 사용하지 않습니다. 회복량과 재사용 대기시간은 변경하지 않습니다. 끄면 즉시 추가 사용을 멈춥니다. 게임을 불러올 때 꺼져 있었다면, 켠 뒤 게임을 다시 불러와야 적용됩니다.");
    this.Text("DisplayName-MBAI-EnableAggressionFloor", "활성");
    this.Text("Description-MBAI-EnableAggressionFloor", "근거리에서 적마다 독립적으로 적용되는 공격 허용 판정, 동시 공격 인원, 좌우 이동 주기를 제어합니다. 팩션별 선택과 사기는 유지됩니다. 인원 조정은 다음 게임 로드부터 적용됩니다.");
    this.Text("DisplayName-MBAI-EnableStealth", "활성");
    this.Text("Description-MBAI-EnableStealth", "적 감지, 수색, 경보, 경계 기억, 시체 발견, 테이크다운 반응을 제어합니다. 위협 기억 기록은 다음 게임 로드부터 적용됩니다.");
    this.Text("DisplayName-MBAI-StealthNoise", "활성");
    this.Text("Description-MBAI-StealthNoise", "플레이어의 이동, 상호작용, 시체 처리, 전투 소음을 제어합니다. 끄면 이 모드가 담당한 모든 소음 경로를 바닐라 또는 호환 모드에 돌려줍니다.");
    this.Text("DisplayName-MBAI-EnableSensors", "활성");
    this.Text("Description-MBAI-EnableSensors", "보안 네트워크가 경계 상태일 때 카메라와 터렛의 감지 속도가 빨라질 수 있습니다. 끄면 다음 감지 판정부터 바닐라 동작으로 복원됩니다.");
    this.Text("DisplayName-MBAI-EnableNetrunner", "활성");
    this.Text("Description-MBAI-EnableNetrunner", "적 넷러너가 팩션 성향에 맞는 방식으로 플레이어를 해킹합니다. 부두 보이즈는 신경계를 태우고, 기업과 넷워치는 제어 퀵핵으로 제압하며, 거리 갱단은 제한적으로 사용하고, 스캐빈저는 사이버웨어를 무력화합니다.");

    this.Text("DisplayName-MBAI-ShowMarksmanshipTuning", "모든 옵션 표시/숨기기");
    this.Text("Description-MBAI-ShowMarksmanshipTuning", "사격술의 모든 옵션을 표시하거나 숨깁니다. 숨겨도 변경 사항은 계속 적용됩니다.");
    this.Text("DisplayName-MBAI-ShowFootworkTuning", "모든 옵션 표시/숨기기");
    this.Text("Description-MBAI-ShowFootworkTuning", "기동의 모든 옵션을 표시하거나 숨깁니다. 숨겨도 변경 사항은 계속 적용됩니다.");
    this.Text("DisplayName-MBAI-ShowPunishTuning", "모든 옵션 표시/숨기기");
    this.Text("Description-MBAI-ShowPunishTuning", "취약 순간 압박의 모든 옵션을 표시하거나 숨깁니다. 숨겨도 변경 사항은 계속 적용됩니다.");
    this.Text("DisplayName-MBAI-ShowFireteamTuning", "모든 옵션 표시/숨기기");
    this.Text("Description-MBAI-ShowFireteamTuning", "분대 전술의 모든 옵션을 표시하거나 숨깁니다. 숨겨도 변경 사항은 계속 적용됩니다.");
    this.Text("DisplayName-MBAI-ShowNerveTuning", "모든 옵션 표시/숨기기");
    this.Text("Description-MBAI-ShowNerveTuning", "신경의 모든 옵션을 표시하거나 숨깁니다. 숨겨도 변경 사항은 계속 적용됩니다.");
    this.Text("DisplayName-MBAI-ShowArchetypesTuning", "모든 옵션 표시/숨기기");
    this.Text("Description-MBAI-ShowArchetypesTuning", "전투 유형의 모든 옵션을 표시하거나 숨깁니다. 숨겨도 변경 사항은 계속 적용됩니다.");
    this.Text("DisplayName-MBAI-ShowAggressionTuning", "모든 옵션 표시/숨기기");
    this.Text("Description-MBAI-ShowAggressionTuning", "공격성 하한의 모든 옵션을 표시하거나 숨깁니다. 숨겨도 변경 사항은 계속 적용됩니다.");
    this.Text("DisplayName-MBAI-ShowStealthTuning", "모든 옵션 표시/숨기기");
    this.Text("Description-MBAI-ShowStealthTuning", "은신의 모든 옵션을 표시하거나 숨깁니다. 숨겨도 변경 사항은 계속 적용됩니다.");
    this.Text("DisplayName-MBAI-ShowAcousticsTuning", "모든 옵션 표시/숨기기");
    this.Text("Description-MBAI-ShowAcousticsTuning", "플레이어 소음의 모든 옵션을 표시하거나 숨깁니다. 숨겨도 변경 사항은 계속 적용됩니다.");
    this.Text("DisplayName-MBAI-ShowSensorsTuning", "모든 옵션 표시/숨기기");
    this.Text("Description-MBAI-ShowSensorsTuning", "감지 장치의 모든 옵션을 표시하거나 숨깁니다. 숨겨도 변경 사항은 계속 적용됩니다.");
    this.Text("DisplayName-MBAI-ShowNetrunnerTuning", "모든 옵션 표시/숨기기");
    this.Text("Description-MBAI-ShowNetrunnerTuning", "넷러너의 모든 옵션을 표시하거나 숨깁니다. 숨겨도 변경 사항은 계속 적용됩니다.");
    this.Text("DisplayName-MBAI-ShowDebugTuning", "모든 옵션 표시/숨기기");
    this.Text("Description-MBAI-ShowDebugTuning", "디버그의 모든 옵션을 표시하거나 숨깁니다. 숨겨도 변경 사항은 계속 적용됩니다.");
    this.Text("UI-MBAI-ShowHide", "표시/숨기기");

    this.Text("Option-MBAI-MarksmanshipHitModelMode-External", "외부 모드 / 끄기");
